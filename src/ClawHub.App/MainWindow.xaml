<?xml version="1.0" encoding="utf-8"?>
<!--
    Interfaccia "da divano" (milestone 2): barra laterale con le sezioni, griglia di copertine,
    sfondo del gioco selezionato. Selezione e comandi sono gestiti in MainWindow.xaml.cs
    (controller e tastiera), non dal focus di XAML.
-->
<Window
    x:Class="ClawHub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ClawHub.App.Views">

    <Grid x:Name="Root" Background="{StaticResource BackgroundBrush}" XYFocusKeyboardNavigation="Disabled">

        <!-- Sfondo dinamico: due immagini che si alternano in dissolvenza. -->
        <Image x:Name="BackdropA" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />
        <Image x:Name="BackdropB" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F205080F" Offset="0" />
                    <GradientStop Color="#A605080F" Offset="0.55" />
                    <GradientStop Color="#6605080F" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#F505080F" Offset="0" />
                    <GradientStop Color="#0005080F" Offset="0.6" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Tiene il focus della tastiera, così i tasti arrivano sempre alla finestra. -->
        <Button x:Name="KeySink" Width="1" Height="1" Opacity="0" UseSystemFocusVisuals="False"
                HorizontalAlignment="Left" VerticalAlignment="Top" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <!-- Barra superiore -->
            <Grid Padding="36,0" ColumnSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF22D3EE" Offset="0" />
                                <GradientStop Color="#FF7C5CFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="CLAW HUB" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20"
                               CharacterSpacing="80" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="TabsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="18,0,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="ClockText" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="26" Height="12" BorderThickness="2" BorderBrush="{StaticResource MutedBrush}" CornerRadius="3" Padding="1">
                            <Rectangle x:Name="BatteryLevel" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" Width="12" RadiusX="1" RadiusY="1" />
                        </Border>
                        <TextBlock x:Name="BatteryText" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Libreria: barra laterale + griglia -->
            <Grid x:Name="LibraryPanel" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#BF05080F" Offset="0" />
                            <GradientStop Color="#5905080F" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Hidden" Padding="28,18,14,18">
                        <StackPanel x:Name="SidebarItems" Spacing="2" />
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Gioco selezionato -->
                    <Grid Padding="40,0,40,0" ColumnSpacing="20" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="18" Height="2" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SectionLabel" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold" FontSize="12" CharacterSpacing="140" />
                            </StackPanel>
                            <TextBlock x:Name="GameTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="34"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock x:Name="GameMeta" Foreground="{StaticResource MutedBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="GameActions" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom" />
                    </Grid>

                    <ScrollViewer x:Name="GridScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
                        <ItemsRepeater x:Name="GamesRepeater" Margin="40,22,40,30">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinItemHeight="260" MinColumnSpacing="26" MinRowSpacing="26"
                                                   MaximumRowsOrColumns="5" ItemsStretch="None" ItemsJustification="Start" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <views:GameCard />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="40,30,40,0" Foreground="{StaticResource MutedBrush}" FontSize="16"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- Dettaglio del gioco -->
            <Grid x:Name="DetailPanel" Grid.Row="1" Visibility="Collapsed" Padding="36,10,36,0" RowSpacing="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="340" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Border CornerRadius="16" Background="{StaticResource PanelBrush}" />
                    <Border CornerRadius="16">
                        <Border.Background>
                            <ImageBrush x:Name="DetailHeroBrush" Stretch="UniformToFill" AlignmentY="Top" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="16" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#D905080F" Offset="0" />
                                <GradientStop Color="#0005080F" Offset="0.6" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Image x:Name="DetailLogo" Stretch="Uniform" MaxHeight="150" MaxWidth="520"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34,0,0,28" />
                    <TextBlock x:Name="DetailTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="60"
                               TextWrapping="WrapWholeWords" MaxLines="2" MaxWidth="720" LineHeight="58"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="34,0,0,24" />
                </Grid>

                <StackPanel x:Name="DetailActions" Grid.Row="1" Orientation="Horizontal" Spacing="12" />

                <Grid x:Name="DetailInfo" Grid.Row="2" ColumnSpacing="28" RowSpacing="16" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>
            </Grid>

            <!-- Impostazioni -->
            <Grid x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Padding="36,30,36,0">
                <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="6">
                    <TextBlock x:Name="SettingsTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="34" />
                    <StackPanel x:Name="SettingsItems" Spacing="4" Margin="0,16,0,0" />
                    <TextBlock x:Name="SettingsNote" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,18,0,0" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource FaintBrush}" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- Legenda dei tasti -->
            <Border Grid.Row="2" Background="#B305080F" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <StackPanel x:Name="LegendPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Spacing="22" Margin="0,0,36,0" />
            </Border>
        </Grid>

        <!-- Collezioni del gioco, sopra a tutto -->
        <Grid x:Name="CollectionsOverlay" Visibility="Collapsed" Background="#B305080F">
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"
                    Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="CollectionsTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="24" />
                    <TextBlock x:Name="CollectionsSubtitle" Foreground="{StaticResource MutedBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="CollectionsList" Spacing="4" />
                    </ScrollViewer>
                    <TextBox x:Name="NewCollectionBox" Visibility="Collapsed" FontSize="16" MaxLength="40" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Avvisi brevi -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,74" Opacity="0" IsHitTestVisible="False"
                Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0"
                CornerRadius="10" Padding="18,12">
            <TextBlock x:Name="ToastText" FontSize="16" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
