<Project Sdk="Microsoft.NET.Sdk">

  <!-- App WinUI 3 non pacchettizzata e autosufficiente: basta estrarre lo zip e avviare ClawHubGames.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ClawHub.App</RootNamespace>
    <AssemblyName>ClawHubGames</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Necessario anche senza pacchetto: genera ClawHubGames.pri con le risorse XAML compilate. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClawHub.Core\ClawHub.Core.csproj" />
    <ProjectReference Include="..\ClawHub.Providers\ClawHub.Providers.csproj" />
  </ItemGroup>

</Project>
